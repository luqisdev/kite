<Window x:Class="KitBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KitBrowser"
        Icon="Resources/kitbrowser.ico"
        Width="1360" Height="860"
        MinWidth="920" MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{DynamicResource BgWindow}"
        FontFamily="{StaticResource UiFont}"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38"
                            CornerRadius="10"
                            GlassFrameThickness="1"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border x:Name="RootFrame" Background="{DynamicResource BgWindow}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Top Bar (Brand + Horizontal Tabs + Window Controls) -->
                <RowDefinition x:Name="TopBarRow" Height="38" />
                <!-- Row 1: Address Bar & Toolbar -->
                <RowDefinition x:Name="AddressBarRow" Height="46" />
                <!-- Row 2: Optional Bookmarks Bar (Ctrl+Shift+O) -->
                <RowDefinition x:Name="BookmarksBarRow" Height="0" />
                <!-- Row 3: Main Workspace -->
                <RowDefinition Height="*" />
                <!-- Row 4: Bottom Auto-Update Notification Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================= ROW 0: TOP BAR ================= -->
            <Grid x:Name="TopBar" Grid.Row="0" Background="{DynamicResource BgSidebar}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,8,0">
                    <Button x:Name="BtnToggleSidebar"
                            Style="{StaticResource IconBtn}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Kenar Çubuğunu Daralt/Genişlet"
                            Click="BtnToggleSidebar_Click"
                            Content="&#xE700;" Margin="0,0,6,0" />
                    <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource AccentBrush}" Margin="0,0,7,0">
                        <TextBlock Text="K" Foreground="White" FontWeight="Bold" FontSize="11.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="KitBrowser" Foreground="{DynamicResource TextPrimary}"
                               FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                    <Border x:Name="InPrivateTopBadge" Visibility="Collapsed" Margin="8,0,0,0"
                            Background="#338B5CF6" CornerRadius="5" Padding="6,2">
                        <TextBlock Text="GİZLİ" Foreground="#C4B5FD" FontSize="10" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Horizontal Tab Bar (Horizontal Mode) -->
                <Grid x:Name="HorizontalTabBarContainer" Grid.Column="1" Visibility="Collapsed" Margin="4,4,8,0">
                    <!-- Scrollable Tabs + '+' button; empty space to the right remains draggable via WindowChrome -->
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <ItemsControl x:Name="HorizontalTabsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="TabBorder"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                MinWidth="150" MaxWidth="220" Height="30" Margin="0,0,4,0" Padding="8,0,6,0"
                                                CornerRadius="8" Cursor="Hand" AllowDrop="True"
                                                Background="{DynamicResource BgSurface}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                PreviewMouseLeftButtonDown="TabItem_PreviewMouseDown"
                                                MouseDown="TabItem_MouseDown"
                                                MouseMove="TabItem_MouseMove"
                                                DragOver="TabItem_DragOver"
                                                Drop="TabItem_Drop"
                                                MouseLeftButtonUp="TabItem_Click"
                                                Tag="{Binding}">
                                            <Border.RenderTransform>
                                                <TranslateTransform X="0" Y="0" />
                                            </Border.RenderTransform>
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-14" To="0" Duration="0:0:0.17">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Sekmeyi Çoğalt" Click="MenuDuplicateTab_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Bölünmüş Ekranda Aç" InputGestureText="Split" Click="MenuSplitTab_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A0;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Sabitle / Sabitlemeyi Kaldır" Click="MenuPinTab_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE718;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Yeni Gruba Ekle" Click="MenuAddToNewGroup_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F4;" FontSize="12" Foreground="{DynamicResource AccentBrush}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Grup Rengini Değiştir" Visibility="{Binding HasGroup, Converter={StaticResource BoolToVis}}" Click="MenuCycleGroupColor_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE790;" FontSize="12" Foreground="{DynamicResource AccentBrush}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Gruptan Çıkar" Visibility="{Binding HasGroup, Converter={StaticResource BoolToVis}}" Click="MenuRemoveFromGroup_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE738;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Grubu Çöz (Sekmeleri Serbest Bırak)" Visibility="{Binding HasGroup, Converter={StaticResource BoolToVis}}" Click="MenuUngroupAll_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F4;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Grubu Kapat (Gruptakileri Kapat)" Visibility="{Binding HasGroup, Converter={StaticResource BoolToVis}}" Click="MenuCloseGroup_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="11" Foreground="{DynamicResource DangerBrush}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Sekmeyi Uyut" InputGestureText="0 MB" Click="MenuSleepTab_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE708;" FontSize="12" Foreground="{DynamicResource WarningBrush}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Diğer Sekmeleri Uyut" Click="MenuSleepOtherTabs_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE708;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Sağdaki Sekmeleri Kapat" Click="MenuCloseTabsToRight_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72A;" FontSize="11" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Sekmeyi Kapat" InputGestureText="Ctrl+W" Click="MenuCloseTab_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="11" Foreground="{DynamicResource DangerBrush}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Optional Colored Group Pill -->
                                                <Border Grid.Column="0" Visibility="{Binding HasGroup, Converter={StaticResource BoolToVis}}"
                                                        Background="{Binding GroupBrush}" CornerRadius="5" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GroupName}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <Grid Grid.Column="1" Width="18" Height="18" Margin="0,0,7,0">
                                                    <Border x:Name="BadgeBg" CornerRadius="5" Background="{DynamicResource AccentSoft}">
                                                        <TextBlock Text="{Binding BadgeLetter}" Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Image Source="{Binding Favicon}" Width="16" Height="16"
                                                           Visibility="{Binding HasFavicon, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                                <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="3" Content="{Binding AudioIcon}"
                                                        Visibility="{Binding ShowAudioButton, Converter={StaticResource BoolToVis}}"
                                                        Style="{StaticResource IconBtn}" Width="20" Height="20" FontSize="10"
                                                        ToolTip="Sesi Aç / Kapat" Click="BtnMuteTab_Click" Tag="{Binding}" />
                                                <TextBlock Grid.Column="4" Text="{Binding SleepBadge}"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           FontSize="10" FontWeight="Bold" Margin="3,0"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="5" Content="&#xE711;"
                                                        Style="{StaticResource IconBtn}" Width="20" Height="20" FontSize="9"
                                                        Click="BtnCloseTab_Click" Tag="{Binding}" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BgActive}" />
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsInPrivate}" Value="True">
                                                <Setter TargetName="BadgeBg" Property="Background" Value="#338B5CF6" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.62" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource IconBtn}" Width="28" Height="28" Margin="2,0,0,0"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Content="&#xE710;" ToolTip="Yeni Sekme (Ctrl+T)" Click="BtnNewTab_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,6,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconBtn}" Width="34" Height="28" FontSize="10"
                            Content="&#xE921;" ToolTip="Küçült" Click="BtnMinimize_Click" />
                    <Button x:Name="BtnMaximize" Style="{StaticResource IconBtn}" Width="34" Height="28" FontSize="10"
                            Content="&#xE922;" ToolTip="Ekranı Kapla" Click="BtnMaximize_Click" />
                    <Button Style="{StaticResource CloseWindowBtn}" FontSize="10"
                            Content="&#xE8BB;" ToolTip="Kapat" Click="BtnCloseWindow_Click" />
                </StackPanel>
            </Grid>

            <!-- ================= ROW 1: ADDRESS BAR & TOOLBAR ================= -->
            <Border x:Name="AddressBarContainer" Grid.Row="1" Background="{DynamicResource BgSidebar}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                    Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Navigation Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button x:Name="BtnBack" Style="{StaticResource IconBtn}" Content="&#xE72B;" ToolTip="Geri (Alt+Sol)" Click="BtnBack_Click" />
                        <Button x:Name="BtnForward" Style="{StaticResource IconBtn}" Content="&#xE72A;" ToolTip="İleri (Alt+Sağ)" Click="BtnForward_Click" />
                        <Button x:Name="BtnReload" Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="Yenile / Durdur (F5)" Click="BtnReload_Click" />
                        <Button Style="{StaticResource IconBtn}" Content="&#xE80F;" ToolTip="Yeni Sekme Ekranı" Click="BtnHome_Click" />
                    </StackPanel>

                    <!-- Omnibox / URL Bar + Autocomplete Popup -->
                    <Border x:Name="OmniboxContainer" Grid.Column="1" Height="34" CornerRadius="10"
                            Background="{DynamicResource BgInput}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                            VerticalAlignment="Center" Padding="8,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnSecurityInfo" Grid.Column="0" Style="{StaticResource IconBtn}"
                                    Width="26" Height="26" Margin="0,0,6,0" ToolTip="Site Bilgisi ve İzinler"
                                    Click="BtnSecurityInfo_Click">
                                <TextBlock x:Name="TxtSecurityIcon"
                                           FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Text="&#xE72E;" Foreground="{DynamicResource SuccessBrush}" />
                            </Button>

                            <!-- Site Info & Permissions Popup -->
                            <Popup x:Name="SiteInfoPopup"
                                   PlacementTarget="{Binding ElementName=BtnSecurityInfo}"
                                   Placement="Bottom" VerticalOffset="6"
                                   AllowsTransparency="True" StaysOpen="False">
                                <Border Width="310" Padding="14" CornerRadius="12"
                                        Background="{DynamicResource BgSurface}"
                                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="#000000" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock x:Name="TxtSiteInfoHost" Text="example.com" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="TxtSiteInfoSecurity" Text="Güvenli Bağlantı (HTTPS)" Foreground="{DynamicResource SuccessBrush}" FontSize="11.5" Margin="0,2,0,12" />
                                        <Separator Margin="0,0,0,10" />
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Kamera" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" VerticalAlignment="Center" />
                                            <Button x:Name="BtnPermCamera" HorizontalAlignment="Right" Style="{StaticResource SubtleBtn}" Content="Sor" Padding="10,3" Tag="camera" Click="BtnCyclePermission_Click" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Mikrofon" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" VerticalAlignment="Center" />
                                            <Button x:Name="BtnPermMic" HorizontalAlignment="Right" Style="{StaticResource SubtleBtn}" Content="Sor" Padding="10,3" Tag="microphone" Click="BtnCyclePermission_Click" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Konum" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" VerticalAlignment="Center" />
                                            <Button x:Name="BtnPermGeo" HorizontalAlignment="Right" Style="{StaticResource SubtleBtn}" Content="Sor" Padding="10,3" Tag="geolocation" Click="BtnCyclePermission_Click" />
                                        </Grid>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="Bildirimler" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" VerticalAlignment="Center" />
                                            <Button x:Name="BtnPermNotif" HorizontalAlignment="Right" Style="{StaticResource SubtleBtn}" Content="Sor" Padding="10,3" Tag="notifications" Click="BtnCyclePermission_Click" />
                                        </Grid>
                                        <Button Style="{StaticResource SubtleBtn}" Content="Bu Sitenin Çerez ve Verilerini Temizle" Click="BtnClearActiveSiteData_Click" />
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <!-- Video Speed & Volume Booster Popup -->
                            <Popup x:Name="MediaBoostPopup"
                                   PlacementTarget="{Binding ElementName=BtnMainMenu}"
                                   Placement="Bottom" VerticalOffset="6" HorizontalOffset="-220"
                                   AllowsTransparency="True" StaysOpen="False">
                                <Border Width="290" Padding="14" CornerRadius="12"
                                        Background="{DynamicResource BgSurface}"
                                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="#000000" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="Video Hızı (Playback Speed)" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <WrapPanel Margin="0,0,0,12">
                                            <Button Style="{StaticResource SubtleBtn}" Content="0.75x" Padding="9,4" Margin="0,0,5,5" Tag="0.75" Click="BtnSetSpeed_Click" />
                                            <Button Style="{StaticResource SubtleBtn}" Content="1x" Padding="9,4" Margin="0,0,5,5" Tag="1.0" Click="BtnSetSpeed_Click" />
                                            <Button Style="{StaticResource SubtleBtn}" Content="1.25x" Padding="9,4" Margin="0,0,5,5" Tag="1.25" Click="BtnSetSpeed_Click" />
                                            <Button Style="{StaticResource SubtleBtn}" Content="1.5x" Padding="9,4" Margin="0,0,5,5" Tag="1.5" Click="BtnSetSpeed_Click" />
                                            <Button Style="{StaticResource SubtleBtn}" Content="2x" Padding="9,4" Margin="0,0,5,5" Tag="2.0" Click="BtnSetSpeed_Click" />
                                            <Button Style="{StaticResource SubtleBtn}" Content="3x" Padding="9,4" Margin="0,0,0,5" Tag="3.0" Click="BtnSetSpeed_Click" />
                                        </WrapPanel>
                                        <Separator Margin="0,0,0,10" />
                                        <TextBlock Text="Ses Yükseltici (Volume Booster)" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SubtleBtn}" Content="%100" Padding="10,4" Margin="0,0,6,0" Tag="1.0" Click="BtnSetVolumeBoost_Click" />
                                            <Button Style="{StaticResource SubtleBtn}" Content="%150" Padding="10,4" Margin="0,0,6,0" Tag="1.5" Click="BtnSetVolumeBoost_Click" />
                                            <Button Style="{StaticResource AccentBtn}" Content="%200 Boost" Padding="10,4" Tag="2.0" Click="BtnSetVolumeBoost_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <TextBox x:Name="TxtAddressBar" Grid.Column="1"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     FontSize="13" VerticalContentAlignment="Center"
                                     PreviewKeyDown="TxtAddressBar_PreviewKeyDown"
                                     TextChanged="TxtAddressBar_TextChanged"
                                     GotKeyboardFocus="TxtAddressBar_GotKeyboardFocus"
                                     LostKeyboardFocus="TxtAddressBar_LostKeyboardFocus"
                                     PreviewMouseLeftButtonDown="TxtAddressBar_PreviewMouseLeftButtonDown" />

                            <Popup x:Name="OmniboxPopup"
                                   PlacementTarget="{Binding ElementName=OmniboxContainer}"
                                   Placement="Bottom"
                                   VerticalOffset="4"
                                   AllowsTransparency="True"
                                   StaysOpen="True"
                                   Focusable="False">
                                <Border Width="{Binding ActualWidth, ElementName=OmniboxContainer}"
                                        Background="{DynamicResource BgSurface}"
                                        BorderBrush="{DynamicResource BorderFocus}"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Padding="6"
                                        Margin="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.45" Color="#000000" />
                                    </Border.Effect>
                                    <ListBox x:Name="OmniboxSuggestionsList"
                                             Background="Transparent" BorderThickness="0"
                                             ItemContainerStyle="{StaticResource CleanListItem}"
                                             MaxHeight="280">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="SugRow" Padding="10,7" Margin="0,1" CornerRadius="7" Cursor="Hand"
                                                        MouseLeftButtonDown="OmniboxSuggestion_MouseDown" Tag="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="68" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{DynamicResource AccentSoft}"
                                                                CornerRadius="5" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource AccentBrush}"
                                                                       FontSize="10" FontWeight="SemiBold" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}"
                                                                       FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Url}" Foreground="{DynamicResource TextMuted}"
                                                                       FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="SugRow" Property="Background" Value="{DynamicResource BgActive}" />
                                                    </DataTrigger>
                                                    <Trigger SourceName="SugRow" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SugRow" Property="Background" Value="{DynamicResource BgHover}" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>

                            <!-- Zoom Badge (visible when != 100%) -->
                            <Button x:Name="BtnZoomReset" Grid.Column="2" Visibility="Collapsed"
                                    Style="{StaticResource SubtleBtn}" Padding="6,2" Margin="4,0" FontSize="10.5"
                                    ToolTip="Yakınlaştırmayı Sıfırla (Ctrl+0)" Click="BtnZoomReset_Click" />

                            <!-- AdBlock Shield Badge (Left click: global toggle, Right click: site whitelist) -->
                            <Button x:Name="BtnAdBlock" Grid.Column="3" Height="24" Padding="7,0" Margin="4,0"
                                    Background="{DynamicResource AccentSoft}" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Sol tık: Reklam Kalkanı Aç/Kapat • Sağ tık: Bu Sitede İzin Ver"
                                    Click="BtnAdBlock_Click"
                                    MouseRightButtonUp="BtnAdBlock_RightClick">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEA18;"
                                                           Foreground="{DynamicResource AccentBrush}" FontSize="11.5" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                           Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="SemiBold"
                                                           Margin="4,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Bookmark Star -->
                            <Button x:Name="BtnBookmark" Grid.Column="4" Style="{StaticResource IconBtn}"
                                    Width="26" Height="26" FontSize="12.5"
                                    Content="&#xE734;" ToolTip="Yer İmlerine Ekle/Çıkar"
                                    Click="BtnBookmark_Click" />
                        </Grid>
                    </Border>

                    <!-- Right Toolbar Actions (Minimal & Clean) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button x:Name="BtnFocusBadge" Visibility="Collapsed" Style="{StaticResource SubtleBtn}"
                                Padding="8,5" Margin="0,0,4,0" ToolTip="Odak Modu (Pomodoro)" Click="BtnPanelFocus_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE916;" FontSize="11"
                                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock x:Name="TxtFocusBadgeTime" Text="25:00" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SubtleBtn}" Padding="9,5" Margin="0,0,4,0"
                                ToolTip="Hızlı Komut Paleti (Ctrl+K)" Click="BtnOpenCommandPalette_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="Ctrl+K" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnProfile" Style="{StaticResource SubtleBtn}" Padding="8,5" Margin="0,0,4,0"
                                ToolTip="Profil Değiştir / Yeni Profil Aç" Click="BtnProfile_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="14" Height="14" CornerRadius="7" Background="{DynamicResource AccentBrush}" Margin="0,0,5,0" />
                                <TextBlock x:Name="TxtProfileName" Text="Kişisel" FontSize="11" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" Content="&#xE896;" ToolTip="İndirmeler" Click="BtnPanelDownloads_Click" />
                        <Button x:Name="BtnMainMenu" Style="{StaticResource IconBtn}" Content="&#xE712;" ToolTip="Menü ve Araçlar" Click="BtnMainMenu_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="MainOverflowMenu">
                                    <MenuItem Header="Yeni Gizli Sekme" InputGestureText="Ctrl+Shift+N" Click="BtnNewInPrivateTab_Click">
                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE727;" FontSize="12" Foreground="#C4B5FD" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Bölünmüş Ekran (Split View)" Click="BtnToggleSplitView_Click">
                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A0;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />

                                    <!-- Kütüphane Submenu -->
                                    <MenuItem Header="Kütüphane">
                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F1;" FontSize="12" Foreground="{DynamicResource AccentBrush}" /></MenuItem.Icon>
                                        <MenuItem Header="Yer İmleri" InputGestureText="Ctrl+Shift+B" Click="BtnOpenBookmarksPage_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE734;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Yer İmi Çubuğu" InputGestureText="Ctrl+Shift+O" Click="BtnToggleBookmarksBar_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE728;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Geçmiş" InputGestureText="Ctrl+H" Click="BtnOpenHistoryPage_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE81C;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="İndirmeler" InputGestureText="Ctrl+J" Click="BtnOpenDownloadsPage_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Okuma Listesi (Sonra Oku)" Click="BtnPanelReadingList_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE82D;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Hızlı Notlar" Click="BtnPanelNotes_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70B;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Şifre Kasası (DPAPI)" InputGestureText="kite://pass" Click="BtnOpenPasswordsPage_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8D7;" FontSize="12" Foreground="{DynamicResource AccentBrush}" /></MenuItem.Icon>
                                        </MenuItem>
                                    </MenuItem>

                                    <!-- Sayfa Araçları Submenu -->
                                    <MenuItem Header="Sayfa Araçları">
                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE90F;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                        <MenuItem Header="Okuyucu Modu (Reader Mode)" Click="BtnReaderMode_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE736;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Video Hızı &amp; %200 Ses Yükseltici" Click="BtnMediaControl_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE767;" FontSize="12" Foreground="{DynamicResource AccentBrush}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Resim İçinde Resim (PiP)" Click="BtnPictureInPicture_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A7;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Mobil Görünüm Modu (iPhone)" Click="BtnMobileMode_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8EA;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Bu Site İçin Karanlık Mod" Click="BtnForceDark_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE708;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sonra Oku'ya Ekle" Click="BtnAddToReadingList_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE82D;" FontSize="12" Foreground="{DynamicResource AccentBrush}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Ekran Görüntüsü Al" InputGestureText="Ctrl+Shift+S" Click="BtnScreenshot_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE722;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="PDF Olarak Kaydet" InputGestureText="Ctrl+P" Click="BtnPrintPdf_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE749;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                        </MenuItem>
                                    </MenuItem>

                                    <!-- Verimlilik & Yan Panel Submenu -->
                                    <MenuItem Header="Verimlilik">
                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE916;" FontSize="12" Foreground="{DynamicResource SuccessBrush}" /></MenuItem.Icon>
                                        <MenuItem Header="Hızlı Yan Uygulamalar (WhatsApp / AI)" Click="BtnPanelWebApp_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A9;" FontSize="12" Foreground="{DynamicResource AccentBrush}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Odak Modu (Pomodoro)" Click="BtnPanelFocus_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE916;" FontSize="12" Foreground="{DynamicResource SuccessBrush}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Dikey ↔ Yatay Sekme Düzeni" Click="BtnSwitchLayout_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A1;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                        </MenuItem>
                                    </MenuItem>

                                    <!-- Gizlilik & Performans Submenu -->
                                    <MenuItem Header="Gizlilik &amp; Performans">
                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEA18;" FontSize="12" Foreground="{DynamicResource SuccessBrush}" /></MenuItem.Icon>
                                        <MenuItem Header="Performans Merkezi" InputGestureText="kite://perf" Click="BtnOpenPerformancePage_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" FontSize="12" Foreground="{DynamicResource SuccessBrush}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Reklam Kalkanı Yönetimi" InputGestureText="kite://adblock" Click="BtnOpenAdBlockPage_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEA18;" FontSize="12" Foreground="{DynamicResource AccentBrush}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Arka Plan Sekmelerini Uyut" InputGestureText="0 MB" Click="BtnSleepInactiveTabs_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE708;" FontSize="12" Foreground="{DynamicResource WarningBrush}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Çift Sekmeleri Temizle" Click="BtnCloseDuplicateTabs_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Tarama Verilerini Temizle" InputGestureText="Ctrl+Shift+Del" Click="BtnClearBrowsingData_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" FontSize="12" Foreground="{DynamicResource DangerBrush}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Tarayıcıyı Kilitle (PIN)" InputGestureText="Ctrl+Shift+L" Click="BtnLockBrowser_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72E;" FontSize="12" Foreground="{DynamicResource WarningBrush}" /></MenuItem.Icon>
                                        </MenuItem>
                                    </MenuItem>

                                    <!-- Geliştirici Submenu -->
                                    <MenuItem Header="Geliştirici">
                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE943;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                        <MenuItem Header="Geliştirici Araçları" InputGestureText="F12" Click="BtnDevTools_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE943;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sayfa Kaynağını Görüntüle" InputGestureText="Ctrl+U" Click="BtnViewSource_Click">
                                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE943;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                        </MenuItem>
                                    </MenuItem>

                                    <Separator />
                                    <MenuItem Header="Ayarlar" InputGestureText="Ctrl+," Click="BtnPanelSettings_Click">
                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Slim 2px GPU Loading Progress Bar -->
            <ProgressBar x:Name="LoadingProgressBar" Grid.Row="1" Height="2" VerticalAlignment="Bottom"
                         IsIndeterminate="True" Visibility="Collapsed"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource AccentBrush}" />

            <!-- ================= ROW 2: OPTIONAL BOOKMARKS BAR (Ctrl+Shift+O) ================= -->
            <Border x:Name="BookmarksBarContainer" Grid.Row="2" Background="{DynamicResource BgSidebar}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                    Padding="10,0">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="BookmarksBarList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,4" Margin="0,0,4,0" CornerRadius="7" Cursor="Hand"
                                        Background="Transparent" ToolTip="{Binding Url}"
                                        MouseLeftButtonUp="BookmarkItem_Click" Tag="{Binding}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BgHover}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,6,0"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="11.5" MaxWidth="140" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ================= ROW 3: WORKSPACE ================= -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="VerticalSidebarColumn" Width="244" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SidePanelColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <!-- VERTICAL SIDEBAR -->
                <Border x:Name="VerticalSidebar" Grid.Column="0"
                        Background="{DynamicResource BgSidebar}"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0"
                        Padding="8,10,8,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- New Tab + InPrivate Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource AccentBtn}" Height="34"
                                    Click="BtnNewTab_Click" ToolTip="Yeni Sekme (Ctrl+T)">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtNewTabBtnLabel" Text="Yeni Sekme" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnSidebarInPrivate" Grid.Column="1" Style="{StaticResource SubtleBtn}"
                                    Width="34" Height="34" Padding="0" Margin="6,0,0,0"
                                    ToolTip="Gizli Sekme (Ctrl+Shift+N)" Click="BtnNewInPrivateTab_Click">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE727;" FontSize="13" />
                            </Button>
                        </Grid>

                        <!-- Vertical Tabs List (Drag & Drop + Optional Group + Pin + Favicon + Audio) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="VerticalTabsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="VTabBorder"
                                                Height="36" Margin="0,0,0,4" Padding="8,0,6,0"
                                                CornerRadius="9" Cursor="Hand" AllowDrop="True"
                                                Background="Transparent"
                                                BorderBrush="Transparent" BorderThickness="1"
                                                PreviewMouseLeftButtonDown="TabItem_PreviewMouseDown"
                                                MouseDown="TabItem_MouseDown"
                                                MouseMove="TabItem_MouseMove"
                                                DragOver="TabItem_DragOver"
                                                Drop="TabItem_Drop"
                                                MouseLeftButtonUp="TabItem_Click"
                                                Tag="{Binding}">
                                            <Border.RenderTransform>
                                                <TranslateTransform X="0" Y="0" />
                                            </Border.RenderTransform>
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-10" To="0" Duration="0:0:0.17">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Sekmeyi Çoğalt" Click="MenuDuplicateTab_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Bölünmüş Ekranda Aç" InputGestureText="Split" Click="MenuSplitTab_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A0;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Sabitle / Sabitlemeyi Kaldır" Click="MenuPinTab_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE718;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Yeni Gruba Ekle" Click="MenuAddToNewGroup_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F4;" FontSize="12" Foreground="{DynamicResource AccentBrush}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Grup Rengini Değiştir" Visibility="{Binding HasGroup, Converter={StaticResource BoolToVis}}" Click="MenuCycleGroupColor_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE790;" FontSize="12" Foreground="{DynamicResource AccentBrush}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Gruptan Çıkar" Visibility="{Binding HasGroup, Converter={StaticResource BoolToVis}}" Click="MenuRemoveFromGroup_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE738;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Grubu Çöz (Sekmeleri Serbest Bırak)" Visibility="{Binding HasGroup, Converter={StaticResource BoolToVis}}" Click="MenuUngroupAll_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F4;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Grubu Kapat (Gruptakileri Kapat)" Visibility="{Binding HasGroup, Converter={StaticResource BoolToVis}}" Click="MenuCloseGroup_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="11" Foreground="{DynamicResource DangerBrush}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Sekmeyi Uyut" InputGestureText="0 MB" Click="MenuSleepTab_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE708;" FontSize="12" Foreground="{DynamicResource WarningBrush}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Diğer Sekmeleri Uyut" Click="MenuSleepOtherTabs_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE708;" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Sağdaki Sekmeleri Kapat" Click="MenuCloseTabsToRight_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72A;" FontSize="11" Foreground="{DynamicResource TextSecondary}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Sekmeyi Kapat" InputGestureText="Ctrl+W" Click="MenuCloseTab_Click" Tag="{Binding}">
                                                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="11" Foreground="{DynamicResource DangerBrush}" /></MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Optional Colored Group Indicator Strip -->
                                                <Border Grid.Column="0" Width="3" Height="18" CornerRadius="2" Margin="0,0,6,0"
                                                        Background="{Binding GroupBrush}"
                                                        Visibility="{Binding HasGroup, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="{Binding GroupName}" />
                                                <Grid Grid.Column="1" Width="22" Height="22" Margin="0,0,8,0">
                                                    <Border x:Name="VBadgeBg" CornerRadius="6" Background="{DynamicResource AccentSoft}">
                                                        <TextBlock Text="{Binding BadgeLetter}" Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="10.5" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Image Source="{Binding Favicon}" Width="16" Height="16"
                                                           Visibility="{Binding HasFavicon, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                                <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" FontFamily="{StaticResource IconFont}" Text="&#xE718;"
                                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"
                                                           Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="3,0"
                                                           VerticalAlignment="Center" ToolTip="Sabit Sekme" />
                                                <Button Grid.Column="4" Content="{Binding AudioIcon}"
                                                        Visibility="{Binding ShowAudioButton, Converter={StaticResource BoolToVis}}"
                                                        Style="{StaticResource IconBtn}" Width="22" Height="22" FontSize="10.5"
                                                        ToolTip="Sesi Aç / Kapat" Click="BtnMuteTab_Click" Tag="{Binding}" />
                                                <TextBlock Grid.Column="5" Text="{Binding SleepBadge}"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           FontSize="10.5" FontWeight="Bold" Margin="3,0"
                                                           ToolTip="Uyuyan Sekme (Bellek Tasarrufu)"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="6" Content="&#xE711;"
                                                        Style="{StaticResource IconBtn}" Width="22" Height="22" FontSize="9.5"
                                                        Click="BtnCloseTab_Click" Tag="{Binding}" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="VTabBorder" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="VTabBorder" Property="Background" Value="{DynamicResource BgHover}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="VTabBorder" Property="Background" Value="{DynamicResource BgActive}" />
                                                <Setter TargetName="VTabBorder" Property="BorderBrush" Value="{DynamicResource BorderFocus}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsInPrivate}" Value="True">
                                                <Setter TargetName="VBadgeBg" Property="Background" Value="#338B5CF6" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                                                <Setter TargetName="VTabBorder" Property="Opacity" Value="0.58" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Sidebar Footer -->
                        <Border x:Name="SidebarFooter" Grid.Row="2" Margin="0,8,0,0" Padding="10,8"
                                CornerRadius="9" Background="{DynamicResource BgSurface}"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtSidebarStats"
                                           Text="0 reklam • 0 uyuyan"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11" TextTrimming="CharacterEllipsis" />
                                <Button Style="{StaticResource SubtleBtn}" Margin="0,6,0,0" Padding="8,4"
                                        Content="Arka Planı Uyut (RAM)" FontSize="11"
                                        Click="BtnSleepInactiveTabs_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- VIEWPORT CONTAINER (Find Bar + Split View + New Tab + Command Palette + Toast) -->
                <Grid Grid.Column="1" Background="{DynamicResource BgWindow}">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Docked Find Bar (Ctrl+F) - zero airspace overlap -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Main & Split WebView Area -->
                        <RowDefinition Height="*" />
                        <!-- Row 2: Subtle Toast Bar -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- FIND IN PAGE BAR (Ctrl+F) -->
                    <Border x:Name="FindBar" Grid.Row="0" Visibility="Collapsed"
                            Background="{DynamicResource BgSurface}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                            Padding="10,6">
                        <Border.RenderTransform>
                            <TranslateTransform />
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox x:Name="TxtFindQuery" Style="{StaticResource ModernInput}" Width="240" Height="30"
                                     KeyDown="TxtFindQuery_KeyDown" />
                            <Button Style="{StaticResource IconBtn}" Width="28" Height="28" Margin="6,0,0,0"
                                    Content="&#xE70E;" ToolTip="Önceki" Click="BtnFindPrev_Click" />
                            <Button Style="{StaticResource IconBtn}" Width="28" Height="28" Margin="2,0,0,0"
                                    Content="&#xE70D;" ToolTip="Sonraki" Click="BtnFindNext_Click" />
                            <Button Style="{StaticResource IconBtn}" Width="28" Height="28" Margin="6,0,0,0"
                                    Content="&#xE711;" ToolTip="Kapat (Esc)" Click="BtnCloseFind_Click" />
                        </StackPanel>
                    </Border>

                    <!-- PRIMARY + SPLIT VIEW AREA -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="SplitSplitterColumn" Width="0" />
                            <ColumnDefinition x:Name="SplitPaneColumn" Width="0" />
                        </Grid.ColumnDefinitions>

                        <!-- Primary Pane -->
                        <Grid Grid.Column="0">
                            <Grid x:Name="WebViewHostGrid" />

                            <!-- NATIVE NEW TAB PAGE -->
                            <Grid x:Name="NewTabOverlay" Background="{DynamicResource BgWindow}" Visibility="Visible">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="NewTabContent" MaxWidth="740" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,56,32,48">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform />
                                        </StackPanel.RenderTransform>
                                        <TextBlock x:Name="TxtNewTabClock" Text="12:00"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="64" FontWeight="Light" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="TxtNewTabGreeting" Text="KitBrowser ile hızlı ve hafif gezinme"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="14" HorizontalAlignment="Center" Margin="0,2,0,28" />

                                        <!-- Sleek Full-Pill Search Box -->
                                        <Border Height="54" CornerRadius="27"
                                                Background="{DynamicResource BgSurface}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                Padding="18,0,8,0" Margin="0,0,0,20">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.28" Color="#000000" />
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}" Text="&#xE721;"
                                                           Foreground="{DynamicResource TextMuted}" FontSize="15"
                                                           VerticalAlignment="Center" Margin="2,0,12,0" />
                                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtNewTabPlaceholder"
                                                               Text="Web'de ara veya bir adres yaz..."
                                                               Foreground="{DynamicResource TextMuted}"
                                                               FontSize="14" IsHitTestVisible="False" VerticalAlignment="Center" />
                                                    <TextBox x:Name="TxtNewTabSearch"
                                                             Background="Transparent" BorderThickness="0"
                                                             Foreground="{DynamicResource TextPrimary}"
                                                             CaretBrush="{DynamicResource AccentBrush}"
                                                             FontSize="14.5" VerticalContentAlignment="Center"
                                                             TextChanged="TxtNewTabSearch_TextChanged"
                                                             KeyDown="TxtNewTabSearch_KeyDown" />
                                                </Grid>
                                                <Button Grid.Column="2" Height="38" Padding="18,0" Cursor="Hand"
                                                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                                                        Click="BtnNewTabSearchGo_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="GoBd" Background="{TemplateBinding Background}" CornerRadius="19" Padding="{TemplateBinding Padding}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="Git" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72A;" FontSize="11"
                                                                               Margin="7,1,0,0" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="GoBd" Property="Opacity" Value="0.88" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Capsule Efficiency Pill -->
                                        <Border CornerRadius="20" Background="{DynamicResource BgSurface}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                Padding="16,8" Margin="0,0,0,28" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEA18;"
                                                           Foreground="{DynamicResource SuccessBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock x:Name="TxtNewTabStats"
                                                           Text="Engellenen Reklam: 0  •  Uyuyan Sekme: 0  •  Reklam Kalkanı: Aktif"
                                                           Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <Grid Margin="6,0,6,12">
                                            <TextBlock Text="Hızlı Erişim" Foreground="{DynamicResource TextSecondary}"
                                                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Button HorizontalAlignment="Right" Style="{StaticResource SubtleBtn}"
                                                    Padding="12,6" Click="BtnToggleAddSpeedDial_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" FontSize="10.5"
                                                               VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock Text="Kısayol Ekle" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <Border x:Name="AddSpeedDialPanel" Visibility="Collapsed"
                                                Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}"
                                                BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtNewSdTitle" Grid.Column="0" Style="{StaticResource ModernInput}"
                                                         Margin="0,0,8,0" ToolTip="Başlık (ör. YouTube)" />
                                                <TextBox x:Name="TxtNewSdUrl" Grid.Column="1" Style="{StaticResource ModernInput}"
                                                         Margin="0,0,8,0" ToolTip="Adres (ör. https://youtube.com)" />
                                                <Button Grid.Column="2" Style="{StaticResource AccentBtn}" Content="Ekle" Click="BtnSaveSpeedDial_Click" />
                                            </Grid>
                                        </Border>

                                        <ItemsControl x:Name="SpeedDialList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="SdCard" Margin="6" Padding="15,13" CornerRadius="14" Cursor="Hand"
                                                            Background="{DynamicResource BgCard}"
                                                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                            ToolTip="{Binding Url}"
                                                            MouseLeftButtonUp="SpeedDialCard_Click" Tag="{Binding}">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.18" Color="#000000" />
                                                        </Border.Effect>
                                                        <Border.RenderTransform>
                                                            <TranslateTransform x:Name="SdLift" Y="0" />
                                                        </Border.RenderTransform>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                                                                    Background="{DynamicResource AccentSoft}" Margin="0,0,12,0">
                                                                <Grid>
                                                                    <TextBlock x:Name="SdLetter" Text="{Binding Letter}" Foreground="{DynamicResource AccentBrush}"
                                                                               FontWeight="Bold" FontSize="15"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <Image Source="{Binding Icon}" Width="22" Height="22"
                                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}"
                                                                       FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <Button x:Name="BtnSdRemove" Grid.Column="2" Style="{StaticResource IconBtn}" Width="22" Height="22"
                                                                    FontSize="9" Content="&#xE711;" ToolTip="Kaldır" Opacity="0"
                                                                    Click="BtnRemoveSpeedDial_Click" Tag="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                            <Setter TargetName="SdLetter" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <Trigger SourceName="SdCard" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="SdCard" Property="Background" Value="{DynamicResource BgHover}" />
                                                            <Setter TargetName="SdCard" Property="BorderBrush" Value="{DynamicResource BorderFocus}" />
                                                            <Setter TargetName="BtnSdRemove" Property="Opacity" Value="1" />
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="SdLift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.12">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                            <Trigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="SdLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.12">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.ExitActions>
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- NATIVE FULL-PAGE SETTINGS (kite://settings) -->
                            <Grid x:Name="SettingsPageOverlay" Background="{DynamicResource BgWindow}" Visibility="Collapsed">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="SettingsPageContent" MaxWidth="780" HorizontalAlignment="Center" Margin="32,38,32,56">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform />
                                        </StackPanel.RenderTransform>

                                        <!-- Page Header -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentSoft}" Margin="0,0,14,0">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Ayarlar" Foreground="{DynamicResource TextPrimary}" FontSize="24" FontWeight="SemiBold" />
                                                <TextBlock Text="kite://settings • Görünüm, performans ve gizlilik tercihleri"
                                                           Foreground="{DynamicResource TextMuted}" FontSize="12" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- CARD 1: GÖRÜNÜM -->
                                        <Border Margin="0,18,0,14" Padding="22,18" CornerRadius="14"
                                                Background="{DynamicResource BgSurface}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE790;" Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="15" VerticalAlignment="Center" Margin="0,0,9,0" />
                                                    <TextBlock Text="Görünüm" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="SemiBold" />
                                                </StackPanel>

                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="260" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="Sekme Düzeni" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium" />
                                                        <TextBlock Text="Dikey kenar çubuğu veya klasik yatay sekme şeridi" Foreground="{DynamicResource TextMuted}" FontSize="11.5" />
                                                    </StackPanel>
                                                    <ComboBox x:Name="CmbLayoutMode" Grid.Column="1" Height="34" SelectionChanged="SettingControl_Changed">
                                                        <ComboBoxItem Content="Dikey Sekmeler (Arc / Zen Tarzı)" Tag="Vertical" />
                                                        <ComboBoxItem Content="Yatay Sekmeler (Minimalist Klasik)" Tag="Horizontal" />
                                                    </ComboBox>
                                                </Grid>

                                                <Separator Margin="0,0,0,14" />

                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="260" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="Tema" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium" />
                                                        <TextBlock Text="Tarayıcı arayüzünün genel renk teması" Foreground="{DynamicResource TextMuted}" FontSize="11.5" />
                                                    </StackPanel>
                                                    <ComboBox x:Name="CmbTheme" Grid.Column="1" Height="34" SelectionChanged="SettingControl_Changed">
                                                        <ComboBoxItem Content="Koyu Tema (Modern Dark)" Tag="Dark" />
                                                        <ComboBoxItem Content="Açık Tema (Clean Light)" Tag="Light" />
                                                    </ComboBox>
                                                </Grid>

                                                <Separator Margin="0,0,0,14" />

                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="Vurgu Rengi" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium" />
                                                        <TextBlock Text="Aktif sekme, buton ve odak renklerini özelleştir" Foreground="{DynamicResource TextMuted}" FontSize="11.5" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource AccentSwatchBtn}" Background="#4F8CFF" Tag="#4F8CFF" ToolTip="Okyanus Mavisi" Click="BtnAccentSwatch_Click" />
                                                        <Button Style="{StaticResource AccentSwatchBtn}" Background="#8B5CF6" Tag="#8B5CF6" ToolTip="Menekşe Moru" Click="BtnAccentSwatch_Click" />
                                                        <Button Style="{StaticResource AccentSwatchBtn}" Background="#10B981" Tag="#10B981" ToolTip="Zümrüt Yeşili" Click="BtnAccentSwatch_Click" />
                                                        <Button Style="{StaticResource AccentSwatchBtn}" Background="#F97316" Tag="#F97316" ToolTip="Gün Batımı Turuncusu" Click="BtnAccentSwatch_Click" />
                                                        <Button Style="{StaticResource AccentSwatchBtn}" Background="#EC4899" Tag="#EC4899" ToolTip="Neon Pembe" Click="BtnAccentSwatch_Click" />
                                                        <Button Style="{StaticResource AccentSwatchBtn}" Background="#EF4444" Tag="#EF4444" Margin="0" ToolTip="Yakut Kırmızısı" Click="BtnAccentSwatch_Click" />
                                                    </StackPanel>
                                                </Grid>

                                                <Separator Margin="0,0,0,14" />

                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="Yeni Sekme Arka Planı" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium" />
                                                        <TextBlock Text="Sade gradient veya kendi bilgisayarından duvar kağıdı seç" Foreground="{DynamicResource TextMuted}" FontSize="11.5" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ComboBox x:Name="CmbNewTabBg" Width="156" Height="34" Margin="0,0,8,0" SelectionChanged="SettingControl_Changed">
                                                            <ComboBoxItem Content="Varsayılan Sade" Tag="Default" />
                                                            <ComboBoxItem Content="Aurora (İndigo)" Tag="Aurora" />
                                                            <ComboBoxItem Content="Gece Yarısı" Tag="Midnight" />
                                                            <ComboBoxItem Content="Gün Batımı" Tag="Sunset" />
                                                            <ComboBoxItem Content="Kuzey Ormanı" Tag="Forest" />
                                                            <ComboBoxItem Content="Özel Duvar Kağıdı" Tag="Custom" />
                                                        </ComboBox>
                                                        <Button Style="{StaticResource SubtleBtn}" Content="Resim Seç" Height="34" Click="BtnPickWallpaper_Click" />
                                                    </StackPanel>
                                                </Grid>

                                                <Separator Margin="0,0,0,14" />

                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="Tüm Sitelerde Zorunlu Karanlık Mod" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium" />
                                                        <TextBlock Text="Açık arka planlı web sitelerini otomatik karanlık moda çevirir" Foreground="{DynamicResource TextMuted}" FontSize="11.5" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="ChkForceDarkGlobal" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                              Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                                </Grid>

                                                <Separator Margin="0,0,0,14" />

                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="Yer İmi Çubuğunu Göster (Ctrl+Shift+O)" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium" />
                                                        <TextBlock Text="Adres çubuğunun altında tek tıkla erişilen yer imi şeridi" Foreground="{DynamicResource TextMuted}" FontSize="11.5" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="ChkShowBookmarksBar" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                              Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                                </Grid>

                                                <Separator Margin="0,0,0,14" />

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="Windows 11 Mica / Yuvarlatılmış Çerçeve" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium" />
                                                        <TextBlock Text="Yerel Windows 11 pencere köşeleri ve derinlik efekti" Foreground="{DynamicResource TextMuted}" FontSize="11.5" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="ChkMicaBackdrop" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                              Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- CARD 2: PERFORMANS & BELLEK -->
                                        <Border Margin="0,0,0,14" Padding="22,18" CornerRadius="14"
                                                Background="{DynamicResource BgSurface}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" Foreground="{DynamicResource SuccessBrush}"
                                                               FontSize="15" VerticalAlignment="Center" Margin="0,0,9,0" />
                                                    <TextBlock Text="Performans ve Bellek" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="SemiBold" />
                                                </StackPanel>

                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="260" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="Akıllı Sekme Uyutma (0 MB RAM)" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium" />
                                                        <TextBlock Text="Belirtilen süre sonunda arka plan sekmelerinin belleği boşaltılır" Foreground="{DynamicResource TextMuted}" FontSize="11.5" />
                                                    </StackPanel>
                                                    <ComboBox x:Name="CmbSleepTimeout" Grid.Column="1" Height="34" SelectionChanged="SettingControl_Changed">
                                                        <ComboBoxItem Content="1 dakika sonra uyut" Tag="1" />
                                                        <ComboBoxItem Content="3 dakika sonra uyut" Tag="3" />
                                                        <ComboBoxItem Content="5 dakika sonra uyut (Önerilen)" Tag="5" />
                                                        <ComboBoxItem Content="10 dakika sonra uyut" Tag="10" />
                                                        <ComboBoxItem Content="30 dakika sonra uyut" Tag="30" />
                                                        <ComboBoxItem Content="Otomatik uyutma kapalı" Tag="0" />
                                                    </ComboBox>
                                                </Grid>

                                                <Separator Margin="0,0,0,14" />

                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="Oturum Geri Yükleme (Uyku Modu)" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium" />
                                                        <TextBlock Text="Açılışta son açık web sitelerini 0 MB RAM uyku modunda geri getirir" Foreground="{DynamicResource TextMuted}" FontSize="11.5" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="ChkRestoreSession" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                              Checked="SettingControl_Changed" Unchecked="SettingControl_Changed" />
                                                </Grid>

                                                <Separator Margin="0,0,0,14" />

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtSettingsPerfInfo" Grid.Column="0"
                                                               Text="Saf Native .NET 8 + WebView2"
                                                               Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                                                    <Button Grid.Column="1" Style="{StaticResource AccentBtn}" Content="Arka Plan Sekmelerini Şimdi Uyut"
                                                            Click="BtnSleepInactiveTabs_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- CARD 3: GİZLİLİK & ARAMA -->
                                        <Border Padding="22,18" CornerRadius="14"
                                                Background="{DynamicResource BgSurface}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEA18;" Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="15" VerticalAlignment="Center" Margin="0,0,9,0" />
                                                    <TextBlock Text="Gizlilik ve Arama" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="SemiBold" />
                                                </StackPanel>

                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="260" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="Varsayılan Arama Motoru" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Medium" />
                                                        <TextBlock Text="Adres çubuğunda arama yapıldığında kullanılacak motor" Foreground="{DynamicResource TextMuted}" FontSize="11.5" />
                                                    </StackPanel>
