                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TxtCustomBlockDomain" Grid.Column="0" Style="{StaticResource ModernInput}" Margin="0,0,8,0" ToolTip="Örn: reklam.example.com" />
                                                    <Button Grid.Column="1" Style="{StaticResource AccentBtn}" Content="Engelle" Click="BtnAddCustomBlockDomain_Click" />
                                                </Grid>
                                                <ItemsControl x:Name="CustomBlockedList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="10,7" Margin="0,0,0,6" CornerRadius="8" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" VerticalAlignment="Center" />
                                                                    <Button HorizontalAlignment="Right" Style="{StaticResource IconBtn}" Width="24" Height="24" FontSize="10"
                                                                            Content="&#xE74D;" Click="BtnRemoveCustomBlockDomain_Click" Tag="{Binding}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Whitelisted Sites -->
                                        <Border Padding="20" CornerRadius="14" Background="{DynamicResource BgSurface}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="İzin Verilen Siteler (Beyaz Liste)" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                                <ItemsControl x:Name="WhitelistedSitesList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="10,7" Margin="0,0,0,6" CornerRadius="8" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" VerticalAlignment="Center" />
                                                                    <Button HorizontalAlignment="Right" Style="{StaticResource SubtleBtn}" Content="İzni Kaldır" Padding="8,3"
                                                                            Click="BtnRemoveWhitelistSite_Click" Tag="{Binding}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <!-- Draggable Split View Divider -->
                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource BorderSubtle}" Cursor="SizeWE" />

                        <!-- Secondary Split View Pane -->
                        <Grid x:Name="SplitPaneContainer" Grid.Column="2" Background="{DynamicResource BgWindow}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource BgSidebar}"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                                    Padding="10,0,6,0">
                                <Grid>
                                    <TextBlock x:Name="TxtSplitHeader" Text="Bölünmüş Ekran"
                                               Foreground="{DynamicResource TextSecondary}" FontSize="11.5"
                                               FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button HorizontalAlignment="Right" Style="{StaticResource IconBtn}" Width="24" Height="24"
                                            FontSize="9.5" Content="&#xE711;" ToolTip="Bölünmüş Ekranı Kapat"
                                            Click="BtnCloseSplitView_Click" />
                                </Grid>
                            </Border>
                            <Grid x:Name="SecondaryWebViewHostGrid" Grid.Row="1" />
                        </Grid>

                        <!-- COMMAND PALETTE OVERLAY (Ctrl+K) -->
                        <Grid x:Name="CommandPaletteOverlay" Grid.ColumnSpan="3" Visibility="Collapsed"
                              Background="{DynamicResource BgOverlay}"
                              MouseLeftButtonDown="CommandPaletteOverlay_MouseDown">
                            <Border x:Name="CommandPaletteCard" Width="580" MaxHeight="480" VerticalAlignment="Top" Margin="0,60,0,0"
                                    CornerRadius="14" Background="{DynamicResource BgSurface}"
                                    BorderBrush="{DynamicResource BorderFocus}" BorderThickness="1"
                                    Padding="12">
                                <Border.RenderTransform>
                                    <TranslateTransform />
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="TxtCommandSearch" Grid.Row="0" Style="{StaticResource ModernInput}"
                                             Height="40" FontSize="14" Margin="0,0,0,10"
                                             TextChanged="TxtCommandSearch_TextChanged"
                                             PreviewKeyDown="TxtCommandSearch_PreviewKeyDown" />
                                    <ListBox x:Name="CommandResultsList" Grid.Row="1"
                                             Background="Transparent" BorderThickness="0"
                                             ItemContainerStyle="{StaticResource CleanListItem}"
                                             MaxHeight="360"
                                             MouseDoubleClick="CommandResultsList_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="CmdRow" Padding="10,8" Margin="0,1" CornerRadius="8" Cursor="Hand"
                                                        MouseLeftButtonUp="CommandResultItem_Click" Tag="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="78" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{DynamicResource AccentSoft}"
                                                                CornerRadius="5" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource AccentBrush}"
                                                                       FontSize="10.5" FontWeight="SemiBold" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}"
                                                                       FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextMuted}"
                                                                       FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="CmdRow" Property="Background" Value="{DynamicResource BgActive}" />
                                                    </DataTrigger>
                                                    <Trigger SourceName="CmdRow" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CmdRow" Property="Background" Value="{DynamicResource BgHover}" />
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- SUBTLE NON-BLOCKING TOAST BAR -->
                    <Border x:Name="ToastBar" Grid.Row="2" Visibility="Collapsed"
                            Background="{DynamicResource BgSurface}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                            Padding="14,7">
                        <Grid>
                            <TextBlock x:Name="TxtToastMessage" Foreground="{DynamicResource TextPrimary}"
                                       FontSize="12" VerticalAlignment="Center" />
                            <Button x:Name="BtnToastAction" HorizontalAlignment="Right" Style="{StaticResource SubtleBtn}"
                                    Padding="10,3" FontSize="11" Visibility="Collapsed" Click="BtnToastAction_Click" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= RIGHT SIDE PANEL ================= -->
                <Border x:Name="SidePanelContainer" Grid.Column="2"
                        Background="{DynamicResource BgSidebar}"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1,0,0,0"
                        Padding="14,12">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock x:Name="TxtSidePanelTitle" Text="Panel"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource IconBtn}"
                                    Content="&#xE711;" Click="BtnCloseSidePanel_Click" />
                        </Grid>

                        <!-- QUICK NOTES VIEW -->
                        <Grid x:Name="PanelNotes" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource BgSurface}"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    CornerRadius="10" Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBox x:Name="TxtNoteTitle" Style="{StaticResource ModernInput}"
                                             Margin="0,0,0,6" ToolTip="Not başlığı" />
                                    <TextBox x:Name="TxtNoteContent" Style="{StaticResource ModernInput}"
                                             Height="78" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top" Margin="0,0,0,8" />
                                    <Grid>
                                        <CheckBox x:Name="ChkNoteLinkSite" Content="Aktif siteyi bağla"
                                                  Foreground="{DynamicResource TextSecondary}" FontSize="11.5"
                                                  VerticalAlignment="Center" IsChecked="True" />
                                        <Button HorizontalAlignment="Right" Style="{StaticResource AccentBtn}"
                                                Content="Kaydet" Padding="12,5" Click="BtnSaveNote_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="NotesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="9"
                                                    Background="{DynamicResource BgSurface}"
                                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}"
                                                                   FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Preview}" Foreground="{DynamicResource TextSecondary}"
                                                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding LinkedUrl}" Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                                                   Cursor="Hand" MouseLeftButtonUp="NoteLink_Click" Tag="{Binding}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Width="24" Height="24"
                                                            FontSize="10" Content="&#xE74D;" VerticalAlignment="Top"
                                                            Click="BtnDeleteNote_Click" Tag="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- DOWNLOADS VIEW -->
                        <Grid x:Name="PanelDownloads" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Style="{StaticResource SubtleBtn}" Content="İndirme Listesini Temizle"
                                    Margin="0,0,0,10" Click="BtnClearDownloads_Click" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="DownloadsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="9" Cursor="Hand"
                                                    Background="{DynamicResource BgSurface}"
                                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                    MouseLeftButtonUp="DownloadItem_Click" Tag="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource TextPrimary}"
                                                               FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="11" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- FOCUS MODE / POMODORO VIEW -->
                        <Grid x:Name="PanelFocus" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="14" CornerRadius="12" Background="{DynamicResource BgSurface}"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Margin="0,0,0,12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtFocusStatus" Text="Odaklanmaya Hazır" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TxtFocusTimer" Text="25:00" Foreground="{DynamicResource TextPrimary}"
                                               FontSize="40" FontWeight="Light" HorizontalAlignment="Center" Margin="0,4,0,12" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button x:Name="BtnFocusStartPause" Style="{StaticResource AccentBtn}" Content="Başlat (25 dk)" Margin="0,0,6,0" Click="BtnFocusStartPause_Click" />
                                        <Button Style="{StaticResource SubtleBtn}" Content="Mola (5 dk)" Margin="0,0,6,0" Click="BtnFocusBreak_Click" />
                                        <Button Style="{StaticResource SubtleBtn}" Content="Sıfırla" Click="BtnFocusReset_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFocusBlockHost" Grid.Column="0" Style="{StaticResource ModernInput}" Margin="0,0,6,0" ToolTip="Engellenecek site (ör. youtube.com)" />
                                <Button Grid.Column="1" Style="{StaticResource SubtleBtn}" Content="Ekle" Click="BtnAddFocusHost_Click" />
                            </Grid>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="FocusBlockedList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,7" Margin="0,0,0,6" CornerRadius="8" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                                <Grid>
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimary}" FontSize="12" VerticalAlignment="Center" />
                                                    <Button HorizontalAlignment="Right" Style="{StaticResource IconBtn}" Width="22" Height="22" FontSize="9.5"
                                                            Content="&#xE711;" Click="BtnRemoveFocusHost_Click" Tag="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- READING LIST (SONRA OKU) VIEW -->
                        <Grid x:Name="PanelReadingList" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Style="{StaticResource AccentBtn}" Content="+ Aktif Sayfayı Sonra Oku'ya Ekle"
                                    Margin="0,0,0,10" Click="BtnAddToReadingList_Click" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ReadingListView">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="9" Cursor="Hand"
                                                    Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                    MouseLeftButtonUp="ReadingItem_Click" Tag="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="10.5" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Width="24" Height="24" FontSize="10"
                                                            Content="&#xE73E;" ToolTip="Okundu İşaretle" Click="BtnToggleReadingRead_Click" Tag="{Binding}" />
                                                    <Button Grid.Column="2" Style="{StaticResource IconBtn}" Width="24" Height="24" FontSize="10"
                                                            Content="&#xE74D;" ToolTip="Sil" Click="BtnDeleteReadingItem_Click" Tag="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- SIDEBAR WEB APPS DRAWER (ChatGPT / WhatsApp / Spotify / Telegram) -->
                        <Grid x:Name="PanelWebApp" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                                <Button Style="{StaticResource SubtleBtn}" Content="ChatGPT" Padding="8,4" Margin="0,0,4,4" Tag="https://chatgpt.com" Click="BtnSideWebAppSelect_Click" />
                                <Button Style="{StaticResource SubtleBtn}" Content="WhatsApp" Padding="8,4" Margin="0,0,4,4" Tag="https://web.whatsapp.com" Click="BtnSideWebAppSelect_Click" />
                                <Button Style="{StaticResource SubtleBtn}" Content="Spotify" Padding="8,4" Margin="0,0,4,4" Tag="https://open.spotify.com" Click="BtnSideWebAppSelect_Click" />
                                <Button Style="{StaticResource SubtleBtn}" Content="Telegram" Padding="8,4" Margin="0,0,4,4" Tag="https://web.telegram.org" Click="BtnSideWebAppSelect_Click" />
                                <Button Style="{StaticResource SubtleBtn}" Content="X" Padding="8,4" Margin="0,0,0,4" Tag="https://x.com" Click="BtnSideWebAppSelect_Click" />
                            </WrapPanel>
                            <Border Grid.Row="1" CornerRadius="10" ClipToBounds="True" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                <Grid x:Name="SideWebAppHostGrid" />
                            </Border>
                        </Grid>

                        <!-- NATIVE KITBROWSER DEVTOOLS (F12) -->
                        <Grid x:Name="PanelDevTools" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- DevTools Sub-Tabs -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="BtnDevTabConsole" Style="{StaticResource SubtleBtn}" Content="Console" Padding="10,4" Margin="0,0,5,0" Click="BtnDevTab_Click" Tag="Console" />
                                <Button x:Name="BtnDevTabElements" Style="{StaticResource SubtleBtn}" Content="Elements" Padding="10,4" Margin="0,0,5,0" Click="BtnDevTab_Click" Tag="Elements" />
                                <Button x:Name="BtnDevTabNetwork" Style="{StaticResource SubtleBtn}" Content="Network" Padding="10,4" Margin="0,0,5,0" Click="BtnDevTab_Click" Tag="Network" />
                                <Button x:Name="BtnDevTabStorage" Style="{StaticResource SubtleBtn}" Content="Storage" Padding="10,4" Click="BtnDevTab_Click" Tag="Storage" />
                            </StackPanel>

                            <!-- 1. CONSOLE TAB -->
                            <Grid x:Name="DevTabConsole" Grid.Row="1" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                                    <ItemsControl x:Name="DevConsoleList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="7" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Level}" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontFamily="Consolas" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextPrimary}" FontSize="11.5" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDevJsInput" Grid.Column="0" Style="{StaticResource ModernInput}" FontFamily="Consolas" FontSize="12"
                                             Margin="0,0,6,0" ToolTip="JavaScript kodu çalıştır (Enter)" KeyDown="TxtDevJsInput_KeyDown" />
                                    <Button Grid.Column="1" Style="{StaticResource AccentBtn}" Content="Çalıştır" Padding="10,6" Margin="0,0,4,0" Click="BtnDevRunJs_Click" />
                                    <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE74D;" ToolTip="Temizle" Click="BtnDevClearConsole_Click" />
                                </Grid>
                            </Grid>

                            <!-- 2. ELEMENTS / DOM TAB -->
                            <Grid x:Name="DevTabElements" Grid.Row="1" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDevSelector" Grid.Column="0" Style="{StaticResource ModernInput}" FontFamily="Consolas" FontSize="12"
                                             Margin="0,0,6,0" ToolTip="CSS seçici (boş = tüm HTML, ör. h1, a, img)" KeyDown="TxtDevSelector_KeyDown" />
                                    <Button Grid.Column="1" Style="{StaticResource AccentBtn}" Content="İncele" Padding="10,6" Click="BtnDevInspectDom_Click" />
                                </Grid>
                                <TextBox x:Name="TxtDevDomOutput" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}"
                                         BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                         FontFamily="Consolas" FontSize="11.5" Padding="10" />
                            </Grid>

                            <!-- 3. NETWORK TAB -->
                            <Grid x:Name="DevTabNetwork" Grid.Row="1" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Style="{StaticResource SubtleBtn}" Content="Ağ Günlüğünü Temizle" Margin="0,0,0,8" Click="BtnDevClearNetwork_Click" />
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="DevNetworkList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="7" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="52" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="NetStatus" Grid.Column="0" Text="{Binding Status}" Foreground="{DynamicResource SuccessBrush}"
                                                                   FontSize="10.5" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Url}" Foreground="{DynamicResource TextPrimary}"
                                                                   FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                        <Setter TargetName="NetStatus" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- 4. STORAGE TAB -->
                            <Grid x:Name="DevTabStorage" Grid.Row="1" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Style="{StaticResource AccentBtn}" Content="Yenile" Padding="12,5" Margin="0,0,6,0" Click="BtnDevRefreshStorage_Click" />
                                    <Button Style="{StaticResource SubtleBtn}" Content="Site Verilerini Temizle" Padding="12,5" Click="BtnClearActiveSiteData_Click" />
                                </StackPanel>
                                <TextBox x:Name="TxtDevStorageOutput" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}"
                                         BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                         FontFamily="Consolas" FontSize="11.5" Padding="10" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= ROW 4: BOTTOM UPDATE NOTIFICATION BAR ================= -->
            <Border x:Name="UpdateBanner" Grid.Row="4" Visibility="Collapsed"
                    Background="{DynamicResource BgSidebar}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
                    Padding="14,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentBrush}" Margin="0,0,9,0" />
                        <TextBlock x:Name="TxtUpdateBanner" Text="Yeni KitBrowser güncellemesi mevcut."
                                   Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnUpdateNowBanner" Style="{StaticResource AccentBtn}"
                                Content="Güncelle" Padding="12,4" Margin="0,0,6,0"
                                Click="BtnApplyUpdate_Click" />
                        <Button Style="{StaticResource SubtleBtn}"
                                Content="Ayarlar" Padding="10,4" Margin="0,0,6,0"
                                Click="BtnOpenUpdateSettings_Click" />
                        <Button Style="{StaticResource IconBtn}" Content="&#xE711;" ToolTip="Kapat"
                                Click="BtnDismissUpdateBanner_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- FULL-WINDOW PIN LOCK OVERLAY (Ctrl+Shift+L) -->
            <Grid x:Name="PinLockOverlay" Grid.RowSpan="5" Panel.ZIndex="999" Visibility="Collapsed"
                  Background="{DynamicResource BgWindow}">
                <Border x:Name="PinLockCard" Width="360" Padding="28" CornerRadius="16"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource BgSurface}"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                    <StackPanel HorizontalAlignment="Stretch">
                        <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AccentSoft}"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72E;" Foreground="{DynamicResource AccentBrush}"
                                       FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="KitBrowser Kilitli" Foreground="{DynamicResource TextPrimary}"
                                   FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Devam etmek için PIN kodunu gir" Foreground="{DynamicResource TextMuted}"
                                   FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,18" />
                        <PasswordBox x:Name="TxtUnlockPin" Height="38" FontSize="16" Padding="10,6"
                                     Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                     KeyDown="TxtUnlockPin_KeyDown" />
                        <TextBlock x:Name="TxtUnlockPinError" Text="Hatalı PIN, tekrar dene." Foreground="{DynamicResource DangerBrush}"
                                   FontSize="11.5" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,8,0,0" />
                        <Button Style="{StaticResource AccentBtn}" Content="Kilidi Aç" Height="36" Margin="0,14,0,0" Click="BtnUnlockPin_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
